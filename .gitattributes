# 统一行尾：默认按内容自动判定为文本并存为 LF；跨平台脚本一律检出为 LF，
# 避免 Windows 检出成 CRLF 后拷进 WSL/Linux 构建时 shell 报 `$'\r'`。
* text=auto eol=lf

# 明确保持 LF 的脚本类
*.sh          text eol=lf
*.bash        text eol=lf
Dockerfile*   text eol=lf
*.dockerfile  text eol=lf
*.py          text eol=lf
*.desktop     text eol=lf
*.service     text eol=lf
*.conf        text eol=lf
*.cfg         text eol=lf
*.toml        text eol=lf
*.ini         text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.json        text eol=lf
*.md          text eol=lf
*.txt         text eol=lf

# Windows 批处理保留 CRLF
*.bat         text eol=crlf
*.cmd         text eol=crlf

# 二进制资源：不做行尾/文本处理
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.icns        binary
*.ttf         binary
*.ttc         binary
*.otf         binary
*.woff        binary
*.woff2       binary
*.zip         binary
*.exe         binary
*.dll         binary
*.so          binary
*.dylib       binary
*.whl         binary
*.pdf         binary
