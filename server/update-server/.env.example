# 复制为 .env 后修改：管理口令必须换成自己的
PAN4DEX_UPDATE_ADMIN_PASSWORD=change-me
PAN4DEX_UPDATE_PORT=10062
# 改端口/主机时用它让旧端口并行监听（老客户端 QSettings 里存的是旧地址，gotchas #77）；
# 230 的 23011 过渡已于 2026-11-25 结束并关闭，新部署不必打开。
#PAN4DEX_UPDATE_EXTRA_PORTS=23011
PAN4DEX_UPDATE_PUBLIC_BASE_URL=http://192.168.5.230:10062
PAN4DEX_UPDATE_MAX_UPLOAD_MB=500
