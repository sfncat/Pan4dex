# ============================================================================
#  Pan4dex Linux 构建镜像 —— 基于通用基座，只补 Pan4dex 专属依赖
# ----------------------------------------------------------------------------
#  基座 packaging/Dockerfile-qt6-builder 提供：Debian 12 bookworm(glibc 2.36)、
#  Qt6/xcb/X/GL 运行库、Xvfb/offscreen、PyQt6 6.12 与 PyInstaller 6.22.3（已锁版本）。
#  本文件只装 Pan4dex 自己的库；Qt6 与 PyInstaller 不要在这里重复安装。
#
#  构建入口：scripts/build-linux-docker.sh（会先确保基座镜像存在）
#  基座 tag 可用 BASE_IMAGE 覆盖（脚本里同名变量），此处 ARG 与之默认一致。
# ============================================================================
ARG BASE_IMAGE=qt6-builder-bookworm:py311
FROM ${BASE_IMAGE}

WORKDIR /app

# Pan4dex 专属依赖（版本与已验证产物一致，锁死）
#   Pillow / pillow-heif：图片与 HEIC 缩略图；QDarkStyle：主题；Send2Trash：回收站；pyte：终端模拟
RUN pip install --only-binary=:all: \
      "Pillow==12.3.0" \
      "pillow-heif==1.8.0" \
      "Send2Trash==2.1.0" \
      "QDarkStyle==3.2.3" \
      "pyte==0.8.2"

# 源码在构建时也 COPY 一份（运行时脚本还会用 -v 挂载覆盖，二者不冲突）
COPY . .

# ENTRYPOINT/CMD 继承自基座（Xvfb :99 + offscreen）
